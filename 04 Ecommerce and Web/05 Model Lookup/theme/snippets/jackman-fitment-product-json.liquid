{%- comment -%} One wheel as JSON for the fitment finder. Usage: render 'jackman-fitment-product-json', p: product {%- endcomment -%}
{
  "title": {{ p.title | json }},
  "url": {{ p.url | json }},
  "image": {% if p.featured_image %}{{ p.featured_image | image_url: width: 600 | json }}{% else %}null{% endif %},
  "variants": [
    {%- for v in p.variants -%}
      { "id": {{ v.id }}, "title": {{ v.title | json }}, "available": {{ v.available | json }}, "price": {{ v.price | money | json }} }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
